text = "If you hear a siren that means one of two things:
A swarm is coming to attack the warehouse from the front (the general area of the Lobby)
Or the final package has been delivered and the evacuation helicopter has arrived. Go to the helicopter for more info"
autowrap_mode = 2

[node name="Label3D21" type="Label3D" parent="statics"]
